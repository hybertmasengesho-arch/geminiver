# Copy this file to .env and fill in real values before running locally.
# cp .env.example .env

PORT=4000

# Supabase → Project Settings → API. Use the SERVICE ROLE key (not anon/public) —
# the server needs full access and bypasses Row Level Security. Never expose
# this key in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Any long random string, used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated emails that get admin access automatically on register/login.
ADMIN_EMAILS=

# Optional. Powers the "Study Helper" chat widget's free-form Q&A (math
# calculation and screen-reading work without this — only general questions
# need it). GEMINI_API_KEY is recommended: Google's free tier needs no
# credit card — get one at aistudio.google.com/apikey. If both are set,
# Gemini is used. Leave both blank to keep the widget calculator-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
