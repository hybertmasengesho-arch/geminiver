# Copy this file to .env for local development.
# On Render, set these under your service's Environment tab instead —
# don't commit a real .env file (it's already in .gitignore).

# ---- Required ----

# Supabase project — Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
# Use the SERVICE ROLE key, not the anon/public key — the server needs to
# bypass row-level security to do its own permission checks in code.
SUPABASE_SERVICE_KEY=your-service-role-key

# Any random long string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- AI study helper (optional, but pick at least one to enable it) ----

# Gemini has a genuinely free API tier — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Anthropic/Claude is paid-only (no free tier) but higher quality.
# If GEMINI_API_KEY is set, Gemini is used even if this is also set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Optional ----

# Comma-separated emails that get admin role on first login, e.g.:
# ADMIN_EMAILS=you@example.com,cofounder@example.com
ADMIN_EMAILS=

# Local dev only — Render sets this automatically, don't set it there.
PORT=4000
